# Copy to .env (local dev) or set these in the Render dashboard (production).
# Never commit real values.

# Port the server listens on (Render sets PORT automatically)
PORT=3000

# Turso (libsql) database. Local dev: file:./data/local.db
# Production: libsql://<your-db>.turso.io
TURSO_DATABASE_URL=file:./data/local.db
# Turso auth token (only needed for remote libsql:// URLs)
TURSO_AUTH_TOKEN=

# Username of the owner/admin account (case-insensitive). The account with
# this username can review (approve/reject) coin requests. Sign up with this
# exact username after deploying to claim the admin account.
ADMIN_USERNAME=sajeel

# Cloudinary — REQUIRED for video and profile-photo (DP) uploads.
# Free signup: https://cloudinary.com — keys are on the Dashboard page.
# Without these, uploads fail with a clear "not configured" message and
# nothing is stored on the server's (ephemeral) disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional overrides for the "Buy coins" page (defaults shown).
# JAZZCASH_NUMBER=03266040350
# JAZZCASH_TITLE=Muhammad Sajeel

# Google sign-in ("Continue with Google") — OPTIONAL.
# Create an OAuth client (Web application) in the Google Cloud Console and
# register the redirect URI:  https://zoomly.onrender.com/api/auth/google/callback
# (for local dev also add:    http://localhost:3000/api/auth/google/callback)
# Without these, the Google button still shows but returns a clear
# "Google login is not configured yet" message.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
